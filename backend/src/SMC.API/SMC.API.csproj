<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>smc-bhoomi-vyavasthapan</UserSecretsId>
    <!-- Prevent default Web SDK globbing from traversing old generated builds. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);build-check/**;build-check-final/**;data-address-build/**;data-validation-build/**;demand-build-check/**;demand-build-final/**;demand-final-build/**;demand-final-build-2/**;demand-final-validation/**;final-data-build/**;runtime-data-build/**;validation-build/**;validation-build-final/**;zone-label-build/**;zone-restore-build/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SMC.Application\SMC.Application.csproj" />
    <ProjectReference Include="..\SMC.Infrastructure\SMC.Infrastructure.csproj" />
  </ItemGroup>
  <!-- Old verification builds were written below this project directory. Exclude
       those generated outputs from Web SDK content discovery/copying. They are
       not application source or runtime assets. -->
  <ItemGroup>
    <Content Remove="build-check\**;build-check-final\**;data-address-build\**;data-validation-build\**;demand-build-check\**;demand-build-final\**;demand-final-build\**;demand-final-build-2\**;demand-final-validation\**;final-data-build\**;runtime-data-build\**;validation-build\**;validation-build-final\**;zone-label-build\**;zone-restore-build\**" />
    <None Remove="build-check\**;build-check-final\**;data-address-build\**;data-validation-build\**;demand-build-check\**;demand-build-final\**;demand-final-build\**;demand-final-build-2\**;demand-final-validation\**;final-data-build\**;runtime-data-build\**;validation-build\**;validation-build-final\**;zone-label-build\**;zone-restore-build\**" />
  </ItemGroup>
</Project>
